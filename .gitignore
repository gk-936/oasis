# secrets and local config
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/

# runtime data: SQLite state, LLM response cache, benchmark checkpoints, token-usage ledger
data/*.db
data/*.db-*
data/llm_cache/
data/bench_cache/
usage.json
**/usage.json

# frontend/dist is deliberately COMMITTED (about 190 KB): the API serves it, so the UI works
# after `pip install` + uvicorn with no Node toolchain. Rebuild with `npm run build` after UI changes.

# editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# persistent trust signing keys (private seeds)
data/keys/

# red-team attempts store (every judge console attempt; input for the next work item)
data/redteam_attempts.jsonl
data/judge_sandbox/

# local tooling (FISCO BCOS WSL distro, Caddy, downloads): scripts/Caddyfile stay tracked
tools/fisco/.keepalive.pid
tools/caddy/data/
tools/caddy/*.exe
tools/caddy/LICENSE
tools/caddy/README.md
tools/caddy/*.log
tools/caddy/*.pem
tools/dl/
tools/tmp/
*.rootfs.tar.gz

# live exchange-rate cache (written when OASIS_RATES=live)
data/rates_cache.json
data/rates_cache.tmp

# the Docker env template is documentation, not a secret
!.env.docker.example

data/passkeys.json
**/passkeys.json
data/telegram_pairing.json
**/telegram_pairing.json
data/telegram_pairing.json
**/telegram_pairing.json

# scripted-client device keys (tools/oasis_client.py)
.oasis_device_key*
