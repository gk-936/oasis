# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# "offline" = deterministic parser, no network (default; used by tests and the scripted demo).
# "groq"    = Groq models for extraction, explanations and AI red-team variants.
OASIS_LLM=offline
# One Groq key, or several separated by commas (key1,key2,key3): when a key reaches its daily limit the adapter moves to the
# next one. Per-minute rate limits are waited out on the same key. Key values are never logged; ledgers use 8-char fingerprints.
GROQ_API_KEY=

# Agent model (Groq preview; may be retired at short notice) with automatic fallback.
OASIS_AGENT_MODEL=qwen/qwen3.8-27b
OASIS_FALLBACK_MODEL=openai/gpt-oss-120b
OASIS_REDTEAM_MODEL=openai/gpt-oss-120b

# Free-tier guard rails, applied PER KEY (Groq free tier: ~30 RPM, 1,000 requests/day, ~200k tokens/day).
OASIS_GROQ_RPM=25
OASIS_GROQ_DAILY_TOKENS=180000
OASIS_GROQ_DAILY_REQUESTS=900

# Image intake (invoice photos / screenshots) uses the same Groq agent model and key: qwen/qwen3.8-27b accepts images.
# The fallback model has no vision, so an unreadable image becomes a hold asking for text, never a guess.

# API persistence: SQLite file (default data/oasis.db). Use :memory: for no persistence.
OASIS_DB=

# Live-agent extraction for the API, and the optional LLM risk scorer (live mode only; escalate-only, max(heuristic, llm)).
# OASIS_EXTRACT=llm
# OASIS_LLM_RISK=1

# Persistent trust signing keys (git-ignored; created on first start). Default data/keys/trust_key.json.
# OASIS_TRUST_KEY=

# Role passcodes for the login screen. The values below are the PUBLIC demo defaults used when these are unset;
# set your own for anything real. OASIS_REQUIRE_CUSTOM_PASSCODES=1 makes the server refuse to start on a default.
# OASIS_PASS_STUDENT=student-demo
# OASIS_PASS_PARENT=parent-demo
# OASIS_PASS_JUDGE=judge-demo
# OASIS_REQUIRE_CUSTOM_PASSCODES=0
# OASIS_SESSION_TTL_S=3600
# Judge mode (set by scripts/start_judge.*): refuses the default passcodes unless OASIS_ALLOW_DEMO_PASSCODES=1, turns /docs off,
# tighter limits (10 red-team attempts/min, 5 failed logins/min, 30-minute sessions). One red-team sandbox per judge session,
# at most OASIS_REDTEAM_MAX_WORLDS (default 20) kept, least recently used evicted. OASIS_ATTEMPTS_FILE moves the attempts log.
# OASIS_JUDGE_MODE=0
# OASIS_ALLOW_DEMO_PASSCODES=0
# OASIS_REDTEAM_MAX_WORLDS=20
# OASIS_ATTEMPTS_FILE=

# Encryption at rest + key files (all git-ignored under data/keys/). They are PLAINTEXT key files protected by OS
# permissions unless OASIS_KEY_PASSPHRASE is set (then new/existing key files are scrypt + AES-GCM wrapped and the
# passphrase must be present at every start).
# OASIS_DATA_KEY=            # AES-256 data key file (default data/keys/data_key.json)
# OASIS_SESSION_SECRET_FILE= # session-token HMAC secret (default data/keys/session_secret.json)
# OASIS_KEY_PASSPHRASE=

# Exchange rates: mock (default, deterministic; used by tests, the benchmark and the scripted demo) | live (real ECB reference
# rate via Frankfurter, jsDelivr fallback; needs internet). Route spreads and fees stay MOCK either way. See docs/live-rates.md.
OASIS_RATES=mock

# Tamper-evidence anchoring of intent hashes: local (default; simulated chain, used by tests and the scripted demo) | fisco
# (a real FISCO BCOS 3.x chain running locally, 4 nodes on one host, driven through WSL; falls back to a labelled local
# simulation if unreachable). Only sha256 hashes go on-chain. See docs/fisco-bcos.md.
OASIS_ANCHOR=local
# OASIS_FISCO_CONTRACT=0x...     # OasisAnchor address; default: read from the distro's /opt/fisco/anchor_contract.txt
# OASIS_FISCO_DISTRO=oasis-fisco # WSL distro that hosts the chain
