# Copy to .env.docker (git-ignored by the .env.* rule) and fill in. NEVER commit .env.docker. docker-compose.yml reads it.
# Values are plain KEY=value (no quotes needed). Everything below is optional unless marked REQUIRED.

# ---- REQUIRED: role passcodes (login screen) ---------------------------------------------------------------------
# The container REFUSES TO START if any of these is unset, or shorter than 8 characters. There are no built-in passcodes.
# Generate with, for example:  python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(16)))"
OASIS_PASS_STUDENT=
OASIS_PASS_PARENT=
OASIS_PASS_JUDGE=

# ---- strongly recommended: encrypt the key files in the /data volume ---------------------------------------------
# Without it the trust signing key, data key and session secret are PLAINTEXT files protected only by file permissions.
# With it they are scrypt + AES-GCM wrapped and this passphrase must be present at EVERY start. Lose it and the volume's
# encrypted database cannot be opened (reset the sandbox instead). Set it BEFORE the first start (an existing plaintext key
# is not silently re-wrapped by changing this later; see docs/deployment-docker.md).
OASIS_KEY_PASSPHRASE=

# ---- judge mode (default 1 in the image) ------------------------------------------------------------------------
# 1 = interactive API docs (/docs, /redoc, /openapi.json) are 404, tighter limits (10 red-team attempts/min, 5 failed
#     logins/min per client IP), 30-minute sessions. Recommended for anything reachable from the internet.
# 0 = personal use: /docs on, looser limits, 1-hour sessions.
OASIS_JUDGE_MODE=1

# ---- LLM: keep OFFLINE for a public instance ---------------------------------------------------------------------
# offline = deterministic parser, no network, no data leaves the container (default, recommended).
# bedrock = text typed into the app (invoices, chat, red-team attempts) is SENT to Amazon Bedrock. NOT recommended for a public judge
#           instance: strangers' input would go to a third party on your account and spend your money.
OASIS_LLM=offline
# Only used when OASIS_LLM=bedrock. Prefer an IAM role; never commit real keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- simulation switches (leave the defaults for a hosted sandbox) ----------------------------------------------
# live = real ECB rates fetched by the server (cached; falls back to MOCK if unreachable). mock = repeatable demo numbers.
OASIS_RATES=live
OASIS_ANCHOR=local

# ---- behind a reverse proxy / HTTPS ------------------------------------------------------------------------------
# Public host(s) allowed in the Origin header of state-changing requests, comma-separated exact origins. Needed only when your
# proxy rewrites the Host header AND you do not use OASIS_TRUST_FORWARDED_HOST. Example: https://oasis.example.com
OASIS_ALLOWED_ORIGINS=
# Force the Secure flag on the session cookie. Leave 0 on plain http://localhost; the cookie also turns Secure automatically
# when the request arrives as https via a trusted proxy (see FORWARDED_ALLOW_IPS).
OASIS_COOKIE_SECURE=0
# Addresses/CIDRs of the reverse proxy whose X-Forwarded-For/-Proto/-Host headers are believed (uvicorn --forwarded-allow-ips).
# docker-compose.yml defaults this to its own network (172.30.77.0/24). Never use * if the container's port is reachable directly
# from the internet: anyone could then spoof their IP and dodge the per-IP rate limits.
# FORWARDED_ALLOW_IPS=172.30.77.0/24

# ---- host settings used by docker-compose.yml (not by the app) --------------------------------------------------
# Host interface/port the app is published on. Default 127.0.0.1:8000 (reachable only from the host; put Caddy/nginx in front).
# Use OASIS_BIND=0.0.0.0 only if you really intend to expose plain HTTP.
# OASIS_BIND=127.0.0.1
# OASIS_PORT=8000
# Public hostname for the optional Caddy `tls` profile (automatic Let's Encrypt HTTPS needs DNS pointing here + ports 80/443 open).
# OASIS_DOMAIN=oasis.example.com
